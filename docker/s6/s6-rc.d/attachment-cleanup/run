#!/command/with-contenv sh
set -eu
[ "${EMBEDDED_WORKER:-off}" = "on" ] || exec sleep infinity
cd /app/server
export HOME=/home/apiuser
while true; do
  if ! s6-setuidgid apiuser /usr/local/bin/bun scripts/cull-staged-attachments.ts; then
    echo "attachment-cleanup: sweep failed; retrying in one hour" >&2
  fi
  sleep 3600 &
  wait "$!"
done
